#!/usr/bin/env bash
# Regression tests for the delegate supervisor. Run from anywhere.
set -euo pipefail

here=$(cd -P -- "$(dirname "$0")" && pwd -P)
script="$here/openmax-tmux"
skill="$here/../SKILL.md"
failures=0

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  failures=$((failures + 1))
}

# Trust grants are human actions. The supervisor must never self-trust a
# directory on the child's behalf, and the skill must not teach that pattern
# in any runnable example (prose telling the human to run it is fine).
if grep -q -- '--trust-project' "$script"; then
  fail "openmax-tmux passes --trust-project to the child"
fi
if sed -n '/^```sh$/,/^```$/p' "$skill" | grep -q -- '--trust-project'; then
  fail "SKILL.md example invokes --trust-project"
fi

# The child command must still run headless print mode in the target project.
grep -qF -- '-p \"\$(cat ' "$script" || fail "openmax-tmux no longer runs the child in print mode"
grep -qF 'cd $quoted_project' "$script" || fail "openmax-tmux no longer cds into the project"

bash -n "$script" || fail "openmax-tmux does not parse"

if [[ $failures -gt 0 ]]; then
  exit 1
fi
printf 'ok\n'
